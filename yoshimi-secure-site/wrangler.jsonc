{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yoshimi-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // wrangler の利用状況を Cloudflare に送らない
  "send_metrics": false,

  // workers.dev の URL を出さない。独自ドメインだけで公開し、
  // ドメイン側の WAF・Bot 対策を迂回できる入口を残さない
  "workers_dev": false,
  "preview_urls": false,

  // 独自ドメイン。Cloudflare にドメインを移してから有効にする（README の「公開する」参照）
  // "routes": [
  //   { "pattern": "yoshimimusubi.com", "custom_domain": true },
  //   { "pattern": "www.yoshimimusubi.com", "custom_domain": true }
  // ],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // /api/ だけ Worker（プログラム）を通す。それ以外は静的ファイルをそのまま返す
    "run_worker_first": ["/api/*"],
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  },

  "vars": {
    "SITE_ORIGIN": "https://yoshimimusubi.com",
    // 送信元は Email Routing を有効にしたドメインのアドレス
    "MAIL_FROM": "noreply@yoshimimusubi.com",
    // 受信用アドレス（下の send_email の destination_address と同じ値にする）
    "MAIL_TO": "contact-inbox@example.com"
  },

  // お問い合わせの通知メール。宛先は Email Routing で確認済みのアドレスだけに限定される
  "send_email": [
    { "name": "MAILER", "destination_address": "contact-inbox@example.com" }
  ],

  // お問い合わせの連続送信を IP ごとに 60 秒 3 回までに抑える
  "ratelimits": [
    { "name": "CONTACT_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }
  ],

  "observability": { "enabled": true }
}
