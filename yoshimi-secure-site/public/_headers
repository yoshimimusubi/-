# 静的ファイルに付けるセキュリティヘッダー（Cloudflare Workers Static Assets の _headers 形式）
# /api/* の応答は worker/http.ts で同等のヘッダーを付けている

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'none'; script-src 'none'; style-src 'self'; img-src 'self' data:; font-src 'self'; manifest-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests; require-trusted-types-for 'script'; trusted-types 'none'; report-uri /api/csp-report; report-to csp
  Reporting-Endpoints: csp="/api/csp-report"
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), browsing-topics=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), serial=(), usb=(), xr-spatial-tracking=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Origin-Agent-Cluster: ?1
  X-Permitted-Cross-Domain-Policies: none

# お問い合わせページだけ、ボット判定（Cloudflare Turnstile）のスクリプトと枠を許可する
/contact/
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data:; font-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests; report-uri /api/csp-report; report-to csp

# ファイル名に内容のハッシュが入っているものは 1 年キャッシュする
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
