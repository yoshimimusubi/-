---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import Icon from "../../components/Icon.astro";
import { NEWS_CATEGORIES, SITE } from "../../data/site";
import Base from "../../layouts/Base.astro";
import { getNews } from "../../lib/content";
import { formatDate, isoDate } from "../../lib/format";

export const getStaticPaths = (async () => {
  const items = await getNews();
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}) satisfies GetStaticPaths;

const { item } = Astro.props;
const { Content } = await render(item);

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "NewsArticle",
    headline: item.data.title,
    description: item.data.excerpt,
    datePublished: isoDate(item.data.date),
    inLanguage: "ja",
    mainEntityOfPage: `${SITE.url}/news/${item.id}/`,
    publisher: { "@type": "Organization", name: SITE.legalName, url: SITE.url },
  },
];
---

<Base title={item.data.title} description={item.data.excerpt} ogType="article" structuredData={structuredData}>
  <article class="article">
    <header class="page-hero">
      <div class="wrap narrow">
        <nav class="breadcrumb" aria-label="パンくずリスト">
          <ol>
            <li><a href="/news/">お知らせ</a></li>
            <li aria-current="page">{item.data.title}</li>
          </ol>
        </nav>
        <div class="news-item__meta">
          <time datetime={isoDate(item.data.date)}>{formatDate(item.data.date)}</time>
          <span class="chip">{NEWS_CATEGORIES[item.data.category]}</span>
        </div>
        <h1>{item.data.title}</h1>
      </div>
    </header>
    <div class="wrap narrow">
      <div class="prose prose--article">
        <Content />
      </div>
      <p class="back-link"><a class="text-link" href="/news/"><Icon name="arrow" size={16} class="icon--flip" /> お知らせ一覧へ戻る</a></p>
    </div>
  </article>
</Base>
