---
import { SITE } from "../data/site";
---

<a class="logo" href="/" aria-label={`${SITE.name} トップページ`}>
  <svg class="logo__mark" viewBox="0 0 32 32" width="32" height="32" aria-hidden="true" focusable="false">
    <path
      class="logo__apple"
      d="M16 9c-2.5-2-7-1.8-9 1.6C4.6 14.6 6 21.5 9.5 25c1.7 1.7 3.6 2.1 5.2 1.3.8-.4 1.8-.4 2.6 0 1.6.8 3.5.4 5.2-1.3 3.5-3.5 4.9-10.4 2.5-14.4C23 7.2 18.5 7 16 9z"
    ></path>
    <path class="logo__leaf" d="M16.5 8.5c.2-2.8 2-4.6 4.8-4.8-.2 2.8-2 4.6-4.8 4.8z"></path>
    <path class="logo__knot" d="M10 17.5c2.2-2.6 4.6-2.6 6 0s3.8 2.6 6 0" fill="none"></path>
  </svg>
  <span class="logo__text">{SITE.name}</span>
</a>
